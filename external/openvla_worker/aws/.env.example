# Copia in aws/.env e compila prima di docker run / compose.
# cp aws/.env.example aws/.env

# --- Sicurezza (obbligatorio in produzione) ---
GO2_WORKER_TOKEN=genera-un-token-lungo-casuale

# --- Backend VLA ---
# Gate G2 (solo rete): OPENVLA_RUNTIME_STUB=1 e OPENVLA_USE_HF=0
# Gate G3 (VLA reale):
GO2_GRASP_WORKER_BACKEND=openvla
OPENVLA_USE_HF=1
OPENVLA_RUNTIME_STUB=0
OPENVLA_HF_MODEL_ID=openvla/openvla-7b
OPENVLA_UNNORM_KEY=bridge_orig
OPENVLA_DEFAULT_INSTRUCTION=pick up the object

# Warmup modello all'avvio container (primo download da Hugging Face)
OPENVLA_WARMUP_ON_START=1

# Hugging Face (solo se modello gated o rate limit)
# HF_TOKEN=hf_...

# --- Server ---
WORKER_BIND_HOST=0.0.0.0
WORKER_PORT=8765
GUNICORN_TIMEOUT_S=180

# --- Opzionale: euristica UI 3D / gripper ---
# OPENVLA_HEURISTIC_ORIGIN_M=0.42,0.0,0.18
# OPENVLA_HEURISTIC_ACTION_SCALE=0.04
# OPENVLA_ACTION_FK_JOINTS=0

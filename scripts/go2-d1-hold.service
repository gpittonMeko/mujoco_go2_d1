[Unit]
Description=Go2 D1 persistent DDS hold daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/go2_visual_dashboard
Environment=GO2_DEPLOY_REMOTE_BASE=/home/unitree/go2_visual_dashboard
ExecStart=/bin/bash -lc 'source /home/unitree/go2_visual_dashboard/scripts/nx_dashboard_env.sh && exec /usr/bin/python3 /home/unitree/go2_visual_dashboard/scripts/d1_hold_daemon.py'
Restart=always
RestartSec=0.2
KillMode=process

[Install]
WantedBy=default.target
